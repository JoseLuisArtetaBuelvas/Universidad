# ========================================================
# VARIABLES DE ENTORNO - SISTEMA UNIVERSIDAD
# ========================================================
# Para uso local: crea una copia de este archivo y nómbrala '.env'.
# Para despliegue en la nube (Render, Railway, AWS, etc.):
# Configura estas variables en el panel de Environment Variables del servicio.

# --------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL)
# --------------------------------------------------------
DB_DRIVER=org.postgresql.Driver
DB_HOST=localhost
DB_PORT=5432
DB_NAME=7502523005_2_Universidad
DB_USER=postgres
DB_PASSWORD=admin

# Opcional: URL completa de conexión (útil en Supabase o Neon con SSL)
# Ejemplo: jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_URL=jdbc:postgresql://localhost:5432/7502523005_2_Universidad

# --------------------------------------------------------
# 2. CORREO ELECTRÓNICO (Jakarta Mail / SMTP)
# --------------------------------------------------------
# Credenciales para el envío de correos de recuperación de contraseña
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_clave_de_aplicacion_gmail
